# Environnement Python isole (plusieurs centaines de Mo, se recree
# avec installer.bat)
venv/
__pycache__/
*.pyc

# Production PyInstaller
build/
dist/
*.spec

# Journaux, propres a chaque machine
lazyshell.log
installation.log

# Contient le PATH utilisateur, donc le nom de compte Windows
# et la liste des logiciels installes. Ne se publie pas.
path_utilisateur_sauvegarde.txt

# Client controleur NVDA : binaire externe, a recuperer chez NV Access
# (voir README.md). On ne versionne pas les binaires tiers.
nvdaControllerClient*.dll

# Reglages locaux d'editeur
.vscode/

# Donnees SSH propres a chaque utilisateur : profils de connexion (nom
# d'hote, utilisateur) et cles d'hotes memorisees. Aucun secret dedans
# (mots de passe/passphrases vont dans le Gestionnaire d'identifiants
# Windows via keyring), mais ca reste des informations sur des serveurs
# reels a ne pas publier.
ssh_profiles.json
known_hosts

# Preferences locales (taille de police...), propres a chaque poste.
settings.json

# Commandes enregistrees par l'utilisateur : personnelles a son usage,
# peuvent reveler des noms de serveurs ou de projets internes.
commands.json
